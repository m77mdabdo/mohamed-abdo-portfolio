APP_NAME="Mohamed Abdo"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8020

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Filled by `bash scripts/create-database.sh` (never commit real values).
DB_CONNECTION=mariadb
DB_SOCKET=/Applications/XAMPP/xamppfiles/var/mysql/mysql.sock
DB_DATABASE=mohamed_abdo_portfolio
DB_USERNAME=map_app
DB_PASSWORD=
# Schema changes, tests and backups (php artisan migrate --database=mariadb_migrate)
DB_MIGRATE_USERNAME=map_migrate
DB_MIGRATE_PASSWORD=
DB_TEST_DATABASE=mohamed_abdo_portfolio_test

# Backups (XAMPP client tools by default)
BACKUP_MYSQLDUMP=/Applications/XAMPP/xamppfiles/bin/mysqldump
BACKUP_MYSQL=/Applications/XAMPP/xamppfiles/bin/mysql
BACKUP_KEEP=14

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
# Development: "log" (notices are written to the log, messages are still saved). Production: smtp + MAIL_*.
MAIL_FROM_ADDRESS="no-reply@localhost"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
