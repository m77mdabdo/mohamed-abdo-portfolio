# Production settings. Copy to .env on the server and fill the empty values there (never commit .env).
# Then: bash scripts/deploy.sh  — and check with: php artisan portfolio:preflight
APP_NAME="Mohamed Abdo"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.example

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

# Database from the hosting panel. Shared hosting usually gives one user: leave DB_MIGRATE_* empty to use it.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_SOCKET=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_MIGRATE_USERNAME=
DB_MIGRATE_PASSWORD=
BACKUP_KEEP=14

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Required: sign-in codes and contact notices are e-mailed. Use the hosting mailbox (or Gmail app password).
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"
